{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Inlined from `astro/tsconfigs/strict` (astro 7.2.2), which this file used
  // to `extends`. The docs site keeps its dependencies in docs/yarn.lock, so
  // `astro` is not installed at the repo root — and every root-level Vite or
  // Ladle command scans this file, fails to resolve the extends, and logs a
  // stack trace. Inlining the options removes the cross-tree dependency.
  // Re-check these against Astro's own preset on the next major upgrade.
  "compilerOptions": {
    // astro/tsconfigs/base.json
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    // astro/tsconfigs/strict.json
    "strict": true,
    // Options this file sets for itself. Astro's preset leaves JSX untouched
    // (`"jsx": "preserve"`); the React integration needs the transform named.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "typeRoots": ["node_modules/@types", "types"]
  },
  // Astro's preset writes these with `${configDir}`, which it needs because the
  // preset is meant to be extended from elsewhere. Nothing extends this file, so
  // plain relative paths — resolved against this directory — mean the same thing.
  // `.astro/types.d.ts` has to be listed explicitly: TypeScript skips
  // dot-directories when expanding `**/*`.
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
