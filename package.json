{
  "name": "kevlar-tabs",
  "version": "1.5.2",
  "description": "Yet another better tabs library for React",
  "type": "module",
  "scripts": {
    "dev": "ladle serve -h 127.0.0.1 --viteConfig vite.ladle.config.ts",
    "build:clean": "rimraf dist && pnpm run build",
    "build:css": "sass src/styles.scss dist/styles.css --no-source-map",
    "build:dts": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:js": "tsc -p tsconfig.build.json && vite build",
    "build:verify": "node scripts/verify-use-client.mjs",
    "build": "pnpm run build:js && pnpm run build:dts && pnpm run build:css && pnpm run build:verify",
    "lint": "eslint .",
    "stories:build": "ladle build --viteConfig vite.ladle.config.ts",
    "stories:preview": "ladle preview -h 127.0.0.1 -p 61000",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "component",
    "tabs",
    "kevlar",
    "frontend",
    "typescript"
  ],
  "license": "MIT",
  "repository": "neolitec/kevlar-tabs",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/kevlar-tabs.es.js",
  "module": "./dist/kevlar-tabs.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kevlar-tabs.es.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@9.3.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.0.1",
    "sass": "^1.79.4",
    "styled-components": "^6.1.13",
    "testing-library-selector": "^0.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-dom": "^0.1.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
